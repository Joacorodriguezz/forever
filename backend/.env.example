NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
API_URL=

# Credenciales de Mercado Pago Sandbox. Completar con tokens TEST-*.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# URLs de retorno. Para mobile se pueden dejar vacias para usar forever://payment/result.
MERCADOPAGO_SUCCESS_URL=
MERCADOPAGO_FAILURE_URL=
MERCADOPAGO_PENDING_URL=

# Debe ser una URL HTTPS publica para que Mercado Pago pueda notificar el pago.
MERCADOPAGO_WEBHOOK_URL=

# SMTP para enviar comprobante de pago.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_TIME=15
CLUB_NAME=Club Deportivo Forever
DESCUENTO_FAMILIAR=0.30
